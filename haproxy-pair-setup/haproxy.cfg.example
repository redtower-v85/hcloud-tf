# HAProxy in front of RKE2 — all nodes on Tailnet.
# Copy to /etc/haproxy/haproxy.cfg and set backends to your RKE2 server
# Tailscale hostnames (e.g. rke2-server-01) or Tailscale IPs (100.x.x.x).

global
  log /dev/log local0
  log /dev/log local1 notice
  chroot /var/lib/haproxy
  stats socket /run/haproxy/admin.sock mode 660 level admin
  stats timeout 30s
  user haproxy
  group haproxy
  daemon

defaults
  log     global
  mode    tcp
  option  tcplog
  option  dontlognull
  timeout connect 5s
  timeout client  50s
  timeout server  50s

# -----------------------------------------------------------------------------
# Kubernetes API (6443) — RKE2 control plane
# -----------------------------------------------------------------------------
frontend k8s_api
  bind *:6443
  default_backend k8s_api_backend

backend k8s_api_backend
  balance roundrobin
  option tcp-check
  default-server inter 3s fall 3 rise 2
  # Replace with your RKE2 server Tailscale hostnames or 100.x.x.x IPs
  server rke2-01 rke2-server-01:6443 check
  server rke2-02 rke2-server-02:6443 check
  server rke2-03 rke2-server-03:6443 check

# -----------------------------------------------------------------------------
# HTTP/HTTPS (optional — Rancher, Ingress, etc.)
# -----------------------------------------------------------------------------
frontend http_front
  mode http
  bind *:80
  default_backend http_backend

frontend https_front
  mode http
  bind *:443
  default_backend https_backend

backend http_backend
  mode http
  balance roundrobin
  option forwardfor
  # RKE2 nodes (Tailscale) serving HTTP
  server rke2-01 rke2-server-01:80 check
  server rke2-02 rke2-server-02:80 check
  server rke2-03 rke2-server-03:80 check

backend https_backend
  mode http
  balance roundrobin
  option forwardfor
  # RKE2 nodes (Tailscale) serving HTTPS
  server rke2-01 rke2-server-01:443 check
  server rke2-02 rke2-server-02:443 check
  server rke2-03 rke2-server-03:443 check

# -----------------------------------------------------------------------------
# Stats (optional, restrict in production)
# -----------------------------------------------------------------------------
listen stats
  mode http
  bind *:8404
  stats enable
  stats uri /stats
  stats refresh 30s
  stats admin if TRUE
